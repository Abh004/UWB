%% =============================================================================
%% NOVELDA X7 DUAL-SENSOR IN-CABIN RADAR ARCHITECTURE (current implementation)
%% 1. Occupancy: physics front end + 3 logistic regressions (36 params)
%%    x7_presence_zone.py, x7_presence_setup.py, models/presence_zone.json
%% 2. Gesture: peak-driven trigger + two-branch CNN ensemble (113,606 params)
%%    x7_gesture_core.py, models/gesture_v3.json
%% Only one pipeline runs at a time, each with its own radar preset.
%% =============================================================================

graph TB
    %% -------------------------------------------------------------------------
    %% SHARED HARDWARE AND ACQUISITION
    %% -------------------------------------------------------------------------
    subgraph HW ["Hardware: 2 x Novelda X7 IR-UWB radar"]
        R1["Radar 1<br/>2 TX x 2 RX (one-axis line array)"]
        R2["Radar 2<br/>2 TX x 2 RX (one-axis line array)"]
    end

    ACQ["Acquisition child process (x7_acq_worker)<br/>holds SDK + GIL, pairs frames by sequence,<br/>parent watchdog; frames over a pipe"]

    R1 --> ACQ
    R2 --> ACQ

    %% -------------------------------------------------------------------------
    %% PIPELINE 1: OCCUPANCY
    %% -------------------------------------------------------------------------
    subgraph OCC ["Occupancy: 5 fps, 112 bins, 30 s window (3 x 10 s blocks)"]
        direction TB
        O_IN["Frame buffer<br/>(150, 2, 2, 2, 112) complex"]
        O_DT["1. Quadratic detrend over time<br/>(MTI + drift removal)"]
        O_FFT["2. FFT over time<br/>breathing 0.2-0.5 Hz, noise 0.8-2.5 Hz"]
        O_REF["3. Reference floor<br/>bins behind the antenna"]
        O_ZONE["4. Zones: front 0.35-1.05 m, back 1.25-2.0 m<br/>(shifted by calibration / auto-alignment)"]
        O_WH["5. Whiten 8 virtual channels x zone bins<br/>by each element's noise-band power"]
        O_FEAT["6. 11 features<br/>per zone: eig vs Marchenko-Pastur edge, ncomp,<br/>snr, br, motion; + front/back coherence"]
        O_LR["3 logistic regressions (12 params each = 36)<br/>occupied, front, back<br/>thresholds for >= 99% recall"]
        O_SM["Asymmetric state machine<br/>enter immediately, hold 45 s after last evidence;<br/>UNKNOWN in warm-up, SENSOR FAULT on stall"]
        O_HM["Health monitor<br/>noise vs calibration (6 dB),<br/>front-row drift (10 cm) -> auto-align"]
        O_OUT["Decision every 1 s<br/>EMPTY / OCCUPIED, front row, back row"]

        O_IN --> O_DT --> O_FFT
        O_FFT --> O_REF & O_ZONE
        O_ZONE --> O_WH
        O_REF & O_WH --> O_FEAT
        O_FEAT --> O_LR --> O_SM --> O_OUT
        O_HM -.-> O_ZONE
        O_HM -.-> O_SM
    end

    %% -------------------------------------------------------------------------
    %% PIPELINE 2: GESTURE
    %% -------------------------------------------------------------------------
    subgraph GES ["Gesture: 40 fps, 34 bins (14 physical, 0.05-0.98 m), 64-frame window"]
        direction TB
        G_SEG["Segmenter<br/>moving energy in hand bins / noise floor;<br/>trigger at 6x idle level, peak + 40 frames, cooldown"]
        G_WIN["Captured window<br/>(64, 2, 2, 2, 14) complex"]
        G_MTI["MTI: subtract window mean"]
        G_ANG["Coherent angle phasor<br/>4 single-baseline pairs averaged (Re, Im)"]
        G_AMP["MTI amplitude<br/>z-scored within window"]
        G_X["Per sensor: (3, 14 bins, 64 frames)"]

        subgraph G_NET ["Two-branch CNN, one branch per board (113,606 params)"]
            G_B1["Branch 1<br/>Conv 3->16 + BN + ReLU, MaxPool(1,2)<br/>Conv 16->32 + BN + ReLU, MaxPool(2)<br/>Conv 32->64 + BN + ReLU<br/>AdaptiveAvgPool(1,8) -> 512"]
            G_B2["Branch 2<br/>same layout, separate weights<br/>-> 512"]
            G_HEAD["Concat 1024 -> Dropout 0.3<br/>Linear 1024->64 + ReLU, Dropout 0.2<br/>Linear 64->6"]
        end

        G_ENS["Ensemble: softmax averaged over 3 seeds"]
        G_DEC["Decision floors<br/>confidence >= 0.65, margin >= 0.40;<br/>NO_GESTURE rejected"]
        G_OUT["SWIPE_LR, SWIPE_RL, SWIPE_UD,<br/>SWIPE_DU, PUSH_IN (or nothing)"]

        G_SEG --> G_WIN --> G_MTI
        G_MTI --> G_ANG & G_AMP
        G_ANG & G_AMP --> G_X
        G_X --> G_B1 & G_B2
        G_B1 & G_B2 --> G_HEAD
        G_HEAD --> G_ENS --> G_DEC --> G_OUT
    end

    ACQ -- "occupancy preset" --> O_IN
    ACQ -- "gesture preset" --> G_SEG
